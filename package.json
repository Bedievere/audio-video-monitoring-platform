{
  "name": "audio-video-monitoring-platform",
  "version": "0.1.0",
  "description": "音视频监播平台 - 用于实时监控广播电视和新媒体内容的单机应用系统",
  "main": "dist-electron/main.js",
  "author": "MonkeyCode-AI <monkeycode-ai@chaitin.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "lint": "eslint src --ext ts,tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "antd": "^5.12.8",
    "better-sqlite3": "file:https://registry.npmmirror.com/@better-sqlite3/better-sqlite3/v9.6.0/better_sqlite3-wasm.wasm",
    "dayjs": "^1.11.10",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.9"
  },
  "build": {
    "appId": "com.monkeycode.audio-video-monitoring",
    "productName": "音视频监播平台",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
